# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
# Update code signing (doc 07 §2.5). The certificate is public by construction
# and MUST be committed — the build reads it and a missing one silently disables
# signing. The private key belongs in KMS and never in the repo.
*.pem
!certs/certificate.pem
keys/

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example
