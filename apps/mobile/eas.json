{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "base": {
      "node": "24.19.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://app.moyolearn.com",
        "EXPO_PUBLIC_AUTH_URL": "https://app.moyolearn.com",
        "EXPO_PUBLIC_AUTH_MODE": "live",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "development"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://app.moyolearn.com",
        "EXPO_PUBLIC_AUTH_URL": "https://app.moyolearn.com",
        "EXPO_PUBLIC_AUTH_MODE": "live",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "preview"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://app.moyolearn.com",
        "EXPO_PUBLIC_AUTH_URL": "https://app.moyolearn.com",
        "EXPO_PUBLIC_AUTH_MODE": "live",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
