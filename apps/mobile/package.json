{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "android:xr": "ORG_GRADLE_PROJECT_reactNativeArchitectures=arm64-v8a expo run:android --device",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/spatial/*.test.ts' 'src/forge-board-probe/*.test.ts'",
    "visionos:pods": "cd visionos && pod install",
    "visionos:build": "xcodebuild -workspace visionos/Moyo.xcworkspace -scheme Moyo -configuration Debug -destination \"generic/platform=visionOS Simulator\" CODE_SIGNING_ALLOWED=NO build",
    "visionos:prepare": "node ../../tooling/prepare-visionos.mjs"
  },
  "dependencies": {
    "@acme/app": "workspace:*",
    "@acme/motion": "workspace:*",
    "@acme/secure": "workspace:*",
    "@acme/theme": "workspace:*",
    "@acme/ui": "workspace:*",
    "@expo-pico/core": "1.0.0",
    "@expo/metro-runtime": "catalog:",
    "@expo/ui": "catalog:",
    "@gorhom/bottom-sheet": "catalog:",
    "@metavr/layout-compat": "catalog:",
    "@metavr/layout-window-compat": "catalog:",
    "@react-native-masked-view/masked-view": "catalog:",
    "@react-navigation/native": "catalog:",
    "@reactvision/react-viro": "3.0.1-moyo.1",
    "@sentry/react-native": "catalog:",
    "@shopify/react-native-skia": "catalog:",
    "@tanstack/react-query": "catalog:",
    "expo": "catalog:",
    "expo-asset": "58.0.21",
    "expo-background-task": "~58.0.13",
