    "expo-drag-drop-content-view": "catalog:",
    "expo-file-system": "58.0.14",
    "expo-font": "catalog:",
    "expo-horizon-core": "58.0.1",
    "expo-image": "catalog:",
    "expo-linking": "catalog:",
    "expo-paste-input": "catalog:",
    "expo-print": "catalog:",
    "expo-router": "catalog:",
    "expo-screen-capture": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-sharing": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-status-bar": "catalog:",
    "expo-system-ui": "catalog:",
    "expo-task-manager": "~58.0.14",
    "expo-updates": "catalog:",
    "expo-web-browser": "catalog:",
    "lucide-react-native": "catalog:",
    "nitro-canvas-in-Vision": "0.0.2-rive.4",
    "nitro-core": "catalog:",
    "react": "catalog:",
