    "@nitro-forge/pen-connect": "file:../../vendors/nitro-forge-pen-connect-0.1.0-moyo.10.tgz"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@callstack/out-of-tree-platforms": "0.77.0",
    "@react-native-community/cli": "20.2.0",
    "@reactvision/react-native-visionos": "0.88.0-moyo.0",
    "@tailwindcss/postcss": "catalog:",
    "@types/react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "eslint": "catalog:",
    "eslint-config-expo": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "unplugin-typegpu": "0.12.9"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          ".*"
        ]
      },
      "ios": {
        "exclude": [
          "expo-updates",
          "expo-updates-interface",
          "expo-structured-headers",
          "expo-manifests",
          "expo-eas-client",
          "expo-json-utils"
        ]
      }
    }
  }
