# Native app env. EXPO_PUBLIC_* only — secrets live in EAS/CI, never in the repo.
EXPO_PUBLIC_APP_URL=http://localhost:3000
# Auth mode: mock (dev fixtures) or live (Better Auth). Wave-3 default is live.
EXPO_PUBLIC_AUTH_MODE=mock
# Dev-only persona: maya, jordan, dana, james, rivera, priya.
EXPO_PUBLIC_MOCK_PERSONA=maya
