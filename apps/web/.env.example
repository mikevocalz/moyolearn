# apps/web — one Next app: public site + Payload admin.
# Prefer the workspace root .env for shared values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Auth mode: mock (dev fixtures) or live (Better Auth). Wave-3 default is live.
NEXT_PUBLIC_AUTH_MODE=mock
# Dev-only persona: maya, jordan, dana, james, rivera, priya.
NEXT_PUBLIC_MOCK_PERSONA=maya
# SERVER-ONLY — never NEXT_PUBLIC_.
PAYLOAD_SECRET=generate-a-long-random-string
PAYLOAD_PUSH=false
DATABASE_URL=postgresql://user:pass@localhost:5432/starter
