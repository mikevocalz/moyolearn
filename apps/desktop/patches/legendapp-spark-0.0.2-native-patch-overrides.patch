+// Moyo Learn patch (apps/desktop/patches/legendapp-spark-0.0.2-native-patch-overrides.patch):
+// an app may replace Spark's expected stamp for a package Spark already requires,
+// through package.json "sparkNativePatchOverrides". The installed package must
+// still carry that exact version, patchHash and upstream source, and every
+// override is printed on every run.
+export function readNativePatchOverrides(root, requirements) {
+    const declared = readJson(path.join(root, "package.json")).sparkNativePatchOverrides;
+    if (declared === undefined)
+        return {};
+    if (!declared || typeof declared !== "object" || Array.isArray(declared))
+        throw new Error("package.json sparkNativePatchOverrides must be an object keyed by package name.");
+    const overrides = {};
+    for (const [name, value] of Object.entries(declared)) {
+        const spark = requirements?.packages?.[name];
+        if (!spark)
+            throw new Error(`package.json sparkNativePatchOverrides.${name}: Spark ${VERSION} has no native patch requirement for ${name}.`);
+        if (!value || typeof value.version !== "string" || !/^[a-f0-9]{64}$/.test(value.patchHash ?? "") ||
+            (!value.upstreamIntegrity && !value.upstreamRevision) || typeof value.reason !== "string" || !value.reason.trim())
+            throw new Error(`package.json sparkNativePatchOverrides.${name} needs version, a 64-character hex patchHash, upstreamIntegrity or upstreamRevision, and reason.`);
+        overrides[name] = { version: value.version, patchHash: value.patchHash, upstreamIntegrity: value.upstreamIntegrity, upstreamRevision: value.upstreamRevision };
+        console.warn(`Spark native patch override: ${name}@${value.version} (patch ${value.patchHash.slice(0, 12)}) replaces Spark's ${name}@${spark.version}. ${value.reason}`);
+    }
+    return overrides;
