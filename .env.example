# Workspace env loaded by all apps.
# Keep secrets in local .env / hosting provider env, never in git.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_APP_URL=http://localhost:3000

# Payload (server-only).
PAYLOAD_SECRET=generate-a-long-random-string
PAYLOAD_PUSH=false
DATABASE_URL=postgresql://user:pass@localhost:5432/starter

# Registers the Payload MCP endpoint. Leave unset outside local dev — the plugin
# has no per-tool access policy yet (doc 13 scope registry).
PAYLOAD_MCP_ENABLED=false
