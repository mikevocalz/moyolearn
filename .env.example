# Workspace env loaded by all apps.
# Keep secrets in local .env / hosting provider env, never in git.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_APP_URL=http://localhost:3000

# Supabase (optional — used for client/edge functions and the Data API).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Payload (server-only).
PAYLOAD_SECRET=generate-a-long-random-string
PAYLOAD_PUSH=false
DATABASE_URL=postgresql://user:pass@localhost:5432/starter

# Registers the Payload MCP endpoint. Leave unset outside local dev — the plugin
# has no per-tool access policy yet (doc 13 scope registry).
PAYLOAD_MCP_ENABLED=false

# Better Auth (doc 06). AUTH_MODE=live swaps the mock session provider for real auth.
EXPO_PUBLIC_AUTH_MODE=mock
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8081
EXPO_PUBLIC_AUTH_URL=http://localhost:8081

# Bunny media (doc 29). Real values live in .env.local, which is gitignored.
# The storage zone is currently SHARED with sosinspires-mono, so everything Moyo
# writes is namespaced under BUNNY_MEDIA_PREFIX. See
# docs/decisions/bunny-storage-presign-spike.md for what is verified and what is not.
BUNNY_STORAGE_ZONE_NAME=your-storage-zone
BUNNY_STORAGE_REGION=ny
BUNNY_STORAGE_ACCESS_KEY=storage-zone-password
BUNNY_MEDIA_PREFIX=moyolearn/
BUNNY_STREAM_LIBRARY_ID=your-stream-library-id
BUNNY_STREAM_ACCESS_KEY=stream-api-key
NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID=$BUNNY_STREAM_LIBRARY_ID
NEXT_PUBLIC_BUNNY_STREAM_EMBED_BASE_URL=https://iframe.mediadelivery.net
NEXT_PUBLIC_BUNNY_STREAM_PULL_ZONE_URL=https://vz-your-zone.b-cdn.net
NEXT_PUBLIC_BUNNY_CDN_BASE_URL=https://your-pull-zone.b-cdn.net
