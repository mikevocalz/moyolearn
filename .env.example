# Workspace env loaded by all apps.
# Keep secrets in local .env / hosting provider env, never in git.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_APP_URL=http://localhost:3000

# Supabase (optional — used for client/edge functions and the Data API).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Payload (server-only).
PAYLOAD_SECRET=generate-a-long-random-string
PAYLOAD_PUSH=false
DATABASE_URL=postgresql://user:pass@localhost:5432/starter

# Registers the Payload MCP endpoint. Leave unset outside local dev — the plugin
# has no per-tool access policy yet (doc 13 scope registry).
PAYLOAD_MCP_ENABLED=false

# Better Auth (doc 06). AUTH_MODE=live swaps the mock session provider for real auth.
EXPO_PUBLIC_AUTH_MODE=mock
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8081
EXPO_PUBLIC_AUTH_URL=http://localhost:8081

# Bunny media (doc 29). Real values live in .env.local, which is gitignored.
# The storage zone is currently SHARED with sosinspires-mono, so everything Moyo
# writes is namespaced under BUNNY_MEDIA_PREFIX. See
# docs/decisions/bunny-storage-presign-spike.md for what is verified and what is not.
BUNNY_STORAGE_ZONE_NAME=your-storage-zone
BUNNY_STORAGE_REGION=ny
BUNNY_STORAGE_ACCESS_KEY=storage-zone-password
BUNNY_MEDIA_PREFIX=moyolearn/
BUNNY_STREAM_LIBRARY_ID=your-stream-library-id
BUNNY_STREAM_ACCESS_KEY=stream-api-key
NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID=$BUNNY_STREAM_LIBRARY_ID
NEXT_PUBLIC_BUNNY_STREAM_EMBED_BASE_URL=https://iframe.mediadelivery.net
NEXT_PUBLIC_BUNNY_STREAM_PULL_ZONE_URL=https://vz-your-zone.b-cdn.net
NEXT_PUBLIC_BUNNY_CDN_BASE_URL=https://your-pull-zone.b-cdn.net
# Dashboard identifiers, handy for support tickets — not used for signing.
BUNNY_STORAGE_ZONE_ID=numeric-zone-id
BUNNY_PULL_ZONE_ID=numeric-pull-zone-id
# S3-compatible endpoint. The Access Key ID is the ZONE NAME and the secret is
# the zone password — there is no separate S3 keypair to create.
BUNNY_S3_ENDPOINT=https://ny-s3.storage.bunnycdn.com

# NEVER put real values in this file. It is committed. They belong in .env.local.

# --- Tutor model (doc 18 §1) -------------------------------------------------
# The Claude key. The name is NOT arbitrary: the Anthropic SDK reads
# ANTHROPIC_API_KEY from the environment itself, so a key stored under any other
# name is a key the tutor cannot see — the session renders as locked with no
# error to explain why. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Media retention sweep (doc 07 §4) ---------------------------------------
# Bearer secret for POST /api/media/sweep, which deletes uploaded media past its
# seven-day window. A shared secret rather than a session because it runs from a
# scheduler with no user — and leaving it open because "only cron knows the URL"
# is an unauthenticated delete endpoint on a children's product.
MEDIA_SWEEP_SECRET=
# Vercel Cron signs its GET with this. Set by Vercel; add locally only to test
# the scheduled path. Without it the cron route refuses rather than running.
CRON_SECRET=

# --- Transcript retention sweep (doc 07 §4) ----------------------------------
# Bearer secret for POST /api/retention/sweep, which deletes session transcripts
# past the window `transcriptExpiry` wrote at capture, every derived fact those
# transcripts are the sole source of, and the Payload version shadow rows behind
# both. Same shape as MEDIA_SWEEP_SECRET and for the same reason: the sweep runs
# from a scheduler with no user, and the endpoint deletes a child's learning
# history. CRON_SECRET above signs the scheduled GET.
RETENTION_SWEEP_SECRET=

# --- Job runner (doc 12 §6 · docs/design/jobs.md) -----------------------------
# Bearer secret for POST /api/jobs/drain, the bounded drain that runs the live
# queues. jobs.md §8.2 left the worker's shape open; this deployment is a Next.js
# app on Vercel, so the answer is a scheduled invocation that drains a bounded
# batch rather than a long-lived process. Same shape and same reasoning as the
# two sweep secrets — the drain executes queued deletions with no user present.
# CRON_SECRET above signs the scheduled GET at /api/jobs/drain/cron.
#
# The queue lives in the `jobs` schema on DATABASE_URL above (one Postgres, doc
# 12 §8). It is installed out of band by `pnpm jobs:install` and NEVER by the
# runtime: packages/jobs/src/boss.ts starts pg-boss with `migrate: false,
# createSchema: false`, because a lambda that cannot alter a schema beats one
# that is trusted not to.
JOBS_DRAIN_SECRET=

# --- Observability (doc 12 §7 · docs/design/slo.md) ---------------------------
# Both SDKs stay OFF when their DSN is empty, which is the state of every
# checkout today: slo.md §2 records that no `moyolearn` Sentry project exists
# yet. A DSN is not a secret in the credential sense — it is public in the
# client bundle by construction — but it still belongs in .env.local, because a
# DSN committed here points every fork's errors at this product's project.
#
# Server errors and traces (apps/web, Node runtime only — see instrumentation.ts).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Fraction of server transactions sampled for LAT-*/AVL-*. Defaults to 0.1.
SENTRY_TRACES_SAMPLE_RATE=
# Browser bundle (apps/web). Public by construction; its beforeSend refuses all
# free text, so message strings never leave the device (slo.md §7 W-7).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Expo app (apps/mobile). Same client-side scrubbing rule as the browser.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Source-map upload and release health — NOT wired yet (slo.md §7 W-2 remainder).
# Listed so the day the project is created there is one place to fill in.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
BUNNY_PULL_ZONE_TOKEN_KEY=

# ElevenLabs — the tutor's ONE voice (doc 32). SERVER-ONLY, never NEXT_PUBLIC_.
# The key is read in exactly one file (packages/voice/src/eleven.ts); the voice
# id is the licensed "Natalie" asset (doc 32 §2, rights review at PR-119).
# Leave both empty and the tutor degrades to text-only — never a substitute voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
