{
  "name": "@acme/ui",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./tw": "./tw.tsx",
    "./primitives": "./primitives/index.tsx",
    "./typography": "./typography.ts",
    "./brand": {
      "react-native": "./brand.ts",
      "default": "./brand.web.ts"
    },
    "./haptics": {
      "react-native": "./haptics.native.ts",
      "default": "./haptics.web.ts"
    },
    "./icons": {
      "react-native": "./icons.native.tsx",
      "default": "./icons.web.ts"
    }
  },
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'audio/**/*.test.ts' 'adaptive-panes/*.test.ts' 'stage-board/*.test.ts'"
  },
  "dependencies": {
    "@acme/theme": "workspace:*",
    "@expo/html-elements": "catalog:",
    "@expo/ui": "catalog:",
    "@legendapp/list": "catalog:",
    "@legendapp/motion": "catalog:",
    "@nandorojo/galeria": "3.0.3",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-pacer": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "expo-drag-drop-content-view": "catalog:",
    "expo-paste-input": "catalog:",
    "lucide-react": "catalog:",
    "lucide-react-native": "catalog:",
    "react-native-css": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-graph": "1.4.0",
    "react-native-mmkv": "catalog:",
    "react-native-pulsar": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-svg": "catalog:",
    "solito": "catalog:",
    "sonner": "catalog:",
    "sonner-native": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:",
    "uniwind": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@acme/config": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "eslint-config-expo": "catalog:",
    "expo": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "expo-router": "*",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo-router": {
      "optional": true
    }
  }
}
