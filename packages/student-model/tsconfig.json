{
  "extends": "@acme/config/typescript/react-library.json",
  // Same posture as @acme/safety: node:test is the runner and the server is the
  // only runtime, so node's types are declared rather than inherited by accident.
  "compilerOptions": { "types": ["node"] },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
