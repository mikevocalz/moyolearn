{
  "extends": "@acme/config/typescript/react-library.json",
  // Same posture as @acme/inference and @acme/safety: node:test is the runner
  // and the server is the only runtime a queue has, so node's types are
  // declared rather than inherited by accident from a sibling.
  "compilerOptions": { "types": ["node"] },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
