    <StateMachine name="BoardChrome" id="0:7">
      <!-- @layers:begin -->
      <StateMachineLayer name="Palette">
        <EntryState x="0" y="0">
          <StateTransition stateToId="0:400" />
        </EntryState>
        <AnyState x="0" y="-160" />
        <ExitState x="0" y="160" />
        <AnimationState id="0:400" animationId="0:330" x="0" y="320">
        <StateTransition stateToId="0:401" duration="120">
          <TransitionViewModelCondition opValue="equal">
            <TransitionPropertyViewModelComparator>
              <BindablePropertyBoolean>
                <DataBindContext sourcePathIds="0:40-0:106" propertyKey="634" />
              </BindablePropertyBoolean>
            </TransitionPropertyViewModelComparator>
            <TransitionValueBooleanComparator value="true" />
          </TransitionViewModelCondition>
          <TransitionViewModelCondition opValue="notEqual">
            <TransitionPropertyViewModelComparator>
              <BindablePropertyBoolean>
                <DataBindContext sourcePathIds="0:40-0:109" propertyKey="634" />
              </BindablePropertyBoolean>
