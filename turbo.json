{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULTS$",
        ".env*",
        "../../.env*"
      ],
      "env": [
        "BUNNY_STORAGE_ZONE_NAME",
        "BUNNY_STORAGE_REGION",
        "BUNNY_STORAGE_ACCESS_KEY",
        "BUNNY_MEDIA_PREFIX",
        "NEXT_PUBLIC_BUNNY_CDN_BASE_URL",
        "BUNNY_PULL_ZONE_TOKEN_KEY",
        "VITE_MOYO_VOICE_BASE_URL"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        ".output/**",
        ".vercel/output/**",
        "storybook-static/**"
      ]
    },
    "@acme/theme#build": {
      "outputs": [
        "theme.css",
        "theme-native.css"
      ]
    },
    "@acme/avatar#typecheck": {
      "outputs": [
        ".types/**"
      ]
    },
    "web#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULTS$",
        ".env*",
        "../../.env*",
        "../../packages/ui/**",
        "../../packages/app/**",
        "../../packages/theme/**"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "storybook#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULTS$",
        "../../.env*",
        "../../packages/ui/**",
        "../../packages/app/**",
        "../../packages/theme/**"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    },
    "web-vite#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULTS$",
        "../../.env*",
        "../../packages/ui/**",
        "../../packages/theme/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "admin-vite#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULTS$",
        "../../.env*",
        "../../packages/payload/**",
        "../../packages/theme/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULTS$"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
