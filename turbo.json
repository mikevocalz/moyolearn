{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "BUNNY_STORAGE_ZONE_NAME",
    "BUNNY_STORAGE_REGION",
    "BUNNY_STORAGE_ACCESS_KEY",
    "BUNNY_MEDIA_PREFIX",
    "NEXT_PUBLIC_BUNNY_CDN_BASE_URL",
    "BUNNY_PULL_ZONE_TOKEN_KEY",
    "VITE_MOYO_VOICE_BASE_URL",
    "ELEVENLABS_API_KEY",
    "ELEVENLABS_VOICE_ID"
  ],
  "tasks": {
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/.env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        ".output/**",
        ".vercel/output/**",
        "storybook-static/**"
      ]
    },
    "@acme/theme#transit": {
      "dependsOn": [
        "^transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!theme.css",
        "!theme-native.css",
        "!payload-admin.css"
      ]
    },
    "@acme/theme#build": {
      "dependsOn": [
        "^build",
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!theme.css",
        "!theme-native.css",
        "!payload-admin.css"
      ],
      "outputs": [
        "theme.css",
        "theme-native.css",
        "payload-admin.css"
      ]
    },
    "web#build": {
      "dependsOn": [
        "^build",
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/.env*"
      ],
      "env": [
        "NODE_ENV",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_DSN",
        "SENTRY_DSN_SERVER",
        "SENTRY_ENVIRONMENT",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_SHA"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "public/natalie/**",
        "public/pdfjs/**"
      ]
    },
    "storybook#build": {
      "dependsOn": [
        "^build",
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env*"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    },
    "web-vite#build": {
      "dependsOn": [
        "^build",
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env*"
      ],
      "env": [
        "NODE_ENV",
        "VITE_*"
      ],
      "outputs": [
        ".output/**",
        ".vercel/output/**",
        ".tanstack/**"
      ]
    },
    "admin-vite#build": {
      "dependsOn": [
        "^build",
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env*"
      ],
      "env": [
        "NODE_ENV",
        "VITE_*"
      ],
      "outputs": [
        "dist/**",
        ".output/**",
        ".vercel/output/**",
        ".tanstack/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "web#typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        "tsconfig.tsbuildinfo"
      ]
    },
    "@acme/avatar#typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.types/**"
      ],
      "outputs": [
        ".types/**",
        ".tsbuild/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "transit"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build",
        "transit"
      ],
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
