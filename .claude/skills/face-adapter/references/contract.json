{
  "$comment": "The face control contract. One entry per channel; every producer writes through this and nothing writes past it. Channel names are ARKit morph-target names verified present on both shipped assets in packages/avatar/rig-manifest.json (52 targets each, identical lists, skeletonsAgree true). FACS AU numbers per https://www.paulekman.com/facial-action-coding-system/; ARKit locations per https://developer.apple.com/documentation/arkit/arfaceanchor/blendshapelocation. Ranges are normalized 0..1 as ARKit defines them. The expressionMax caps are AUTHORED for Moyo and must be calibrated against the legibility gate, not cited as constants -- audit/motion/realism-2026-09-10.md requires gates be calibrated and recorded.",
  "version": 1,
  "owners": {
    "speech": "The viseme solver or Audio2Face. Owns articulation.",
    "expression": "The tone-to-performance planner, through EmotionState.",
    "blink": "The idle engine's blink hazard model.",
    "gaze": "The idle engine's saccade/aversion model plus the camera-look bias."
  },
  "resolutions": {
    "exclusive": "One owner. A second writer is a bug; assert it.",
    "speech-priority": "Speech takes the channel outright while articulating. Expression may write it only when speech is inactive, and only up to expressionMax.",
    "capped-additive": "Both write. Expression's contribution is clamped to expressionMax and added under speech, then the sum is clamped to 1."
  },
  "channels": {
    "browInnerUp": { "group": "AU", "au": "AU1", "facs": "inner brow raiser", "owner": "expression", "resolution": "exclusive", "range": [0, 1] },
    "browOuterUpLeft": { "group": "AU", "au": "AU2", "facs": "outer brow raiser", "owner": "expression", "resolution": "exclusive", "range": [0, 1] },
    "browOuterUpRight": { "group": "AU", "au": "AU2", "facs": "outer brow raiser", "owner": "expression", "resolution": "exclusive", "range": [0, 1] },
    "browDownLeft": { "group": "AU", "au": "AU4", "facs": "brow lowerer", "owner": "expression", "resolution": "exclusive", "range": [0, 1] },
    "browDownRight": { "group": "AU", "au": "AU4", "facs": "brow lowerer", "owner": "expression", "resolution": "exclusive", "range": [0, 1] },
    "eyeWideLeft": { "group": "AU", "au": "AU5", "facs": "upper lid raiser", "owner": "expression", "resolution": "capped-additive", "expressionMax": 0.6, "range": [0, 1], "note": "The idle engine's anticipation beat also raises this. Additive under the cap so a surprise tone and an anticipation beat do not cancel into one flat value." },
    "eyeWideRight": { "group": "AU", "au": "AU5", "facs": "upper lid raiser", "owner": "expression", "resolution": "capped-additive", "expressionMax": 0.6, "range": [0, 1] },
    "cheekSquintLeft": { "group": "AU", "au": "AU6", "facs": "cheek raiser", "owner": "expression", "resolution": "exclusive", "range": [0, 1], "note": "AU6 is the Duchenne marker. Without it a smile reads as polite compliance, which is the wrong thing for a tutor to signal after a wrong answer." },
    "cheekSquintRight": { "group": "AU", "au": "AU6", "facs": "cheek raiser", "owner": "expression", "resolution": "exclusive", "range": [0, 1] },
    "eyeSquintLeft": { "group": "AU", "au": "AU7", "facs": "lid tightener", "owner": "expression", "resolution": "exclusive", "range": [0, 1] },
    "eyeSquintRight": { "group": "AU", "au": "AU7", "facs": "lid tightener", "owner": "expression", "resolution": "exclusive", "range": [0, 1] },
    "noseSneerLeft": { "group": "AU", "au": "AU9", "facs": "nose wrinkler", "owner": "expression", "resolution": "exclusive", "range": [0, 0.3], "note": "Capped low. AU9 at full is disgust, and no pedagogical tone in the palette is disgust." },
    "noseSneerRight": { "group": "AU", "au": "AU9", "facs": "nose wrinkler", "owner": "expression", "resolution": "exclusive", "range": [0, 0.3] },
    "mouthSmileLeft": { "group": "AU", "au": "AU12", "facs": "lip corner puller", "owner": "expression", "resolution": "capped-additive", "expressionMax": 0.45, "range": [0, 1], "note": "THE cap that keeps articulation legible. EMOTION_PRESETS.happiness writes 0.55 here today; under the current per-channel max that beats every viseme below it and the corners stop articulating for the whole sentence." },
    "mouthSmileRight": { "group": "AU", "au": "AU12", "facs": "lip corner puller", "owner": "expression", "resolution": "capped-additive", "expressionMax": 0.45, "range": [0, 1] },
    "mouthDimpleLeft": { "group": "AU", "au": "AU14", "facs": "dimpler", "owner": "expression", "resolution": "capped-additive", "expressionMax": 0.3, "range": [0, 1] },
    "mouthDimpleRight": { "group": "AU", "au": "AU14", "facs": "dimpler", "owner": "expression", "resolution": "capped-additive", "expressionMax": 0.3, "range": [0, 1] },
    "mouthFrownLeft": { "group": "AU", "au": "AU15", "facs": "lip corner depressor", "owner": "expression", "resolution": "capped-additive", "expressionMax": 0.35, "range": [0, 1] },
    "mouthFrownRight": { "group": "AU", "au": "AU15", "facs": "lip corner depressor", "owner": "expression", "resolution": "capped-additive", "expressionMax": 0.35, "range": [0, 1] },
    "mouthShrugUpper": { "group": "AU", "au": "AU17", "facs": "chin raiser", "owner": "expression", "resolution": "speech-priority", "expressionMax": 0.35, "range": [0, 1] },
    "mouthShrugLower": { "group": "AU", "au": "AU17", "facs": "chin raiser", "owner": "expression", "resolution": "speech-priority", "expressionMax": 0.35, "range": [0, 1] },
    "cheekPuff": { "group": "AU", "au": "AU33", "facs": "cheek blow", "owner": "speech", "resolution": "exclusive", "range": [0, 1], "note": "No palette tone writes this. Speech only, and rarely." },

    "jawOpen": { "group": "VIS", "au": "AU26", "facs": "jaw drop", "owner": "speech", "resolution": "exclusive", "range": [0, 1], "note": "EMOTION_PRESETS.surprise writes jawOpen 0.15 today. Under per-channel max that becomes a floor the mouth cannot close below, so bilabials stop closing while the tone holds. Expression must not write this channel." },
    "jawForward": { "group": "VIS", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "jawLeft": { "group": "VIS", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "jawRight": { "group": "VIS", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "mouthClose": { "group": "VIS", "au": "AU24", "facs": "lip pressor", "owner": "speech", "resolution": "exclusive", "range": [0, 1], "note": "A2F's mouthClose deviates from ARKit: the SDK's includes jaw opening. Apply the deviation gain in map-a2f-to-contract.md before writing." },
    "mouthPressLeft": { "group": "VIS", "au": "AU24", "facs": "lip pressor", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "mouthPressRight": { "group": "VIS", "au": "AU24", "facs": "lip pressor", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "mouthFunnel": { "group": "VIS", "au": "AU22", "facs": "lip funneler", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "mouthPucker": { "group": "VIS", "au": "AU18", "facs": "lip pucker", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "mouthStretchLeft": { "group": "VIS", "au": "AU20", "facs": "lip stretcher", "owner": "speech", "resolution": "exclusive", "range": [0, 1], "note": "Viseme SPREAD lives here, not on mouthSmile*. Separating them is what lets a tone hold the corners while the mouth still articulates." },
    "mouthStretchRight": { "group": "VIS", "au": "AU20", "facs": "lip stretcher", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "mouthRollUpper": { "group": "VIS", "au": "AU28", "facs": "lip suck", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "mouthRollLower": { "group": "VIS", "au": "AU28", "facs": "lip suck", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "mouthUpperUpLeft": { "group": "VIS", "au": "AU10", "facs": "upper lip raiser", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "mouthUpperUpRight": { "group": "VIS", "au": "AU10", "facs": "upper lip raiser", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "mouthLowerDownLeft": { "group": "VIS", "au": "AU16", "facs": "lower lip depressor", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "mouthLowerDownRight": { "group": "VIS", "au": "AU16", "facs": "lower lip depressor", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "mouthLeft": { "group": "VIS", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "mouthRight": { "group": "VIS", "owner": "speech", "resolution": "exclusive", "range": [0, 1] },
    "tongueOut": { "group": "VIS", "au": "AU19", "facs": "tongue show", "owner": "speech", "resolution": "exclusive", "range": [0, 0.4], "note": "A2F does not fully animate the tongue. Drive from the viseme table or leave at zero; never from expression." },

    "eyeBlinkLeft": { "group": "BLINK", "au": "AU45", "facs": "blink", "owner": "blink", "resolution": "exclusive", "range": [0, 1], "note": "EMOTION_PRESETS.sadness writes eyeBlinkLeft/Right 0.15 today. Under the contract that becomes AU43 (lid droop) on eyeSquint, not a blink-channel write -- a permanent partial blink is a stuck lid, not an expression." },
    "eyeBlinkRight": { "group": "BLINK", "au": "AU45", "facs": "blink", "owner": "blink", "resolution": "exclusive", "range": [0, 1] },

    "eyeLookUpLeft": { "group": "GAZE", "owner": "gaze", "resolution": "exclusive", "range": [0, 1] },
    "eyeLookUpRight": { "group": "GAZE", "owner": "gaze", "resolution": "exclusive", "range": [0, 1] },
    "eyeLookDownLeft": { "group": "GAZE", "owner": "gaze", "resolution": "exclusive", "range": [0, 1] },
    "eyeLookDownRight": { "group": "GAZE", "owner": "gaze", "resolution": "exclusive", "range": [0, 1] },
    "eyeLookInLeft": { "group": "GAZE", "owner": "gaze", "resolution": "exclusive", "range": [0, 1] },
    "eyeLookInRight": { "group": "GAZE", "owner": "gaze", "resolution": "exclusive", "range": [0, 1] },
    "eyeLookOutLeft": { "group": "GAZE", "owner": "gaze", "resolution": "exclusive", "range": [0, 1] },
    "eyeLookOutRight": { "group": "GAZE", "owner": "gaze", "resolution": "exclusive", "range": [0, 1] }
  },
  "conflicts": [
    { "id": "closed-and-funnelled", "a": ["mouthClose"], "b": ["mouthFunnel", "mouthPucker"], "thresholdA": 0.6, "thresholdB": 0.3, "why": "Lips cannot be pressed shut and rounded open at the same instant." },
    { "id": "closed-and-stretched", "a": ["mouthClose"], "b": ["mouthStretchLeft", "mouthStretchRight"], "thresholdA": 0.6, "thresholdB": 0.35, "why": "A pressed-shut mouth cannot be stretched wide." },
    { "id": "closed-and-jaw-open", "a": ["mouthClose"], "b": ["jawOpen"], "thresholdA": 0.85, "thresholdB": 0.2, "why": "The bilabial closure clamp sets mouthClose to its floor and jawOpen to its ceiling together. One without the other means two writers disagreed." },
    { "id": "corners-up-and-down-left", "a": ["mouthSmileLeft"], "b": ["mouthFrownLeft"], "thresholdA": 0.25, "thresholdB": 0.25, "why": "AU12 and AU15 are antagonists on the same corner." },
    { "id": "corners-up-and-down-right", "a": ["mouthSmileRight"], "b": ["mouthFrownRight"], "thresholdA": 0.25, "thresholdB": 0.25, "why": "AU12 and AU15 are antagonists on the same corner." },
    { "id": "wide-and-blinking-left", "a": ["eyeWideLeft"], "b": ["eyeBlinkLeft"], "thresholdA": 0.3, "thresholdB": 0.4, "why": "AU5 and AU45 are antagonists on the same lid. Both active means blink and expression are fighting for the channel." },
    { "id": "wide-and-blinking-right", "a": ["eyeWideRight"], "b": ["eyeBlinkRight"], "thresholdA": 0.3, "thresholdB": 0.4, "why": "AU5 and AU45 are antagonists on the same lid." },
    { "id": "brow-up-and-down-left", "a": ["browOuterUpLeft", "browInnerUp"], "b": ["browDownLeft"], "thresholdA": 0.3, "thresholdB": 0.3, "why": "AU1/AU2 and AU4 are antagonists. Simultaneous means two tones blended without a mask." },
    { "id": "brow-up-and-down-right", "a": ["browOuterUpRight", "browInnerUp"], "b": ["browDownRight"], "thresholdA": 0.3, "thresholdB": 0.3, "why": "AU1/AU2 and AU4 are antagonists." },
    { "id": "squint-and-wide-left", "a": ["eyeSquintLeft"], "b": ["eyeWideLeft"], "thresholdA": 0.4, "thresholdB": 0.4, "why": "AU7 and AU5 are antagonists on the same lid aperture." },
    { "id": "squint-and-wide-right", "a": ["eyeSquintRight"], "b": ["eyeWideRight"], "thresholdA": 0.4, "thresholdB": 0.4, "why": "AU7 and AU5 are antagonists." },
    { "id": "look-in-and-out-left", "a": ["eyeLookInLeft"], "b": ["eyeLookOutLeft"], "thresholdA": 0.15, "thresholdB": 0.15, "why": "One eye cannot converge and diverge at once. gazeMorphs cannot produce this; two gaze writers can." },
    { "id": "look-up-and-down-left", "a": ["eyeLookUpLeft"], "b": ["eyeLookDownLeft"], "thresholdA": 0.15, "thresholdB": 0.15, "why": "Same, vertically." }
  ]
}
