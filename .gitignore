# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules

# Environment
.env
.env.*
!.env.example

# Build outputs
dist
*.tsbuildinfo
storybook-static

# Caches
.turbo
.expo
.vercel
# TanStack Start's scratch dir (apps/web-vite). Empty between runs, so it only
# shows up once a dev server has written the route generator's temp files.
.tanstack

# OS
.DS_Store

# Local MCP server config. Untracked on purpose: it holds absolute paths to this
# machine's checkout, so a committed copy breaks for everyone else and silently
# points their tools at a directory they do not have.
.mcp.json

# The marketing site's photography cache. Unlike the globe's vendored topojson
# these are not a build input: `scripts/build-photography.mjs` runs by hand, its
# OUTPUT is committed under public/images, and the originals are re-fetchable
# from the Pexels ids recorded in public/images/MANIFEST.md. Committing a 2400px
# colour original per photograph would be repo weight nothing reads.
apps/web-vite/data/photography/
