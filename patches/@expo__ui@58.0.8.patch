+++ b/src/jetpack-compose/NavigationRail/index.tsx
@@ -0,0 +1,142 @@
+import { requireNativeView } from 'expo';
+import { type ColorValue } from 'react-native';
+
+import { type NavigationBarItemColors } from '../NavigationBar';
+import { type ModifierConfig, type ViewEvent } from '../../types';
+import { createViewModifierEventListener } from '../modifiers';
+
+type SlotProps = {
+  children: React.ReactNode;
+};
+
+type NativeSlotViewProps = {
+  slotName: string;
+  children: React.ReactNode;
+};
+
+export interface WideNavigationRailProps {
+  /** Whether the Material wide rail is expanded into its labeled desktop form. */
+  expanded?: boolean;
+  containerColor?: ColorValue;
+  contentColor?: ColorValue;
+  modifiers?: ModifierConfig[];
+  children?: React.ReactNode;
+}
+
+export interface WideNavigationRailItemProps {
+  selected: boolean;
+  /** Must match the parent rail's expanded state for Material's item animation. */
+  railExpanded?: boolean;
+  onClick?: () => void;
+  enabled?: boolean;
+  colors?: NavigationBarItemColors;
+  modifiers?: ModifierConfig[];
+  children?: React.ReactNode;
+}
+
+type NativeWideNavigationRailItemProps = Omit<WideNavigationRailItemProps, 'onClick'> &
+  ViewEvent<'onButtonPressed', void>;
+
+const WideNavigationRailNativeView: React.ComponentType<WideNavigationRailProps> =
+  requireNativeView('ExpoUI', 'WideNavigationRailView');
+
+const WideNavigationRailItemNativeView: React.ComponentType<NativeWideNavigationRailItemProps> =
+  requireNativeView('ExpoUI', 'WideNavigationRailItemView');
+
+const SlotNativeView: React.ComponentType<NativeSlotViewProps> = requireNativeView(
+  'ExpoUI',
+  'SlotView'
+);
+
+function transformRailProps(props: WideNavigationRailProps): WideNavigationRailProps {
+  const { modifiers, ...restProps } = props;
+  return {
+    modifiers,
+    ...(modifiers ? createViewModifierEventListener(modifiers) : undefined),
+    ...restProps,
+  };
+}
+
+function transformRailItemProps(
+  props: WideNavigationRailItemProps
+): NativeWideNavigationRailItemProps {
+  const { modifiers, onClick, ...restProps } = props;
+  return {
+    modifiers,
+    ...(modifiers ? createViewModifierEventListener(modifiers) : undefined),
+    ...restProps,
+    onButtonPressed: () => onClick?.(),
+  };
+}
+
+function WideNavigationRailHeader(props: SlotProps) {
+  return <SlotNativeView slotName="header">{props.children}</SlotNativeView>;
+}
+
+function WideNavigationRailItemIcon(props: SlotProps) {
+  return <SlotNativeView slotName="icon">{props.children}</SlotNativeView>;
+}
+
+function WideNavigationRailItemLabel(props: SlotProps) {
+  return <SlotNativeView slotName="label">{props.children}</SlotNativeView>;
+}
+
+function WideNavigationRailComponent(props: WideNavigationRailProps) {
+  const { children, ...restProps } = props;
+  return (
+    <WideNavigationRailNativeView {...transformRailProps(restProps)}>
+      {children}
+    </WideNavigationRailNativeView>
+  );
+}
+
+function WideNavigationRailItemComponent(props: WideNavigationRailItemProps) {
+  const { children, ...restProps } = props;
+  return (
+    <WideNavigationRailItemNativeView {...transformRailItemProps(restProps)}>
+      {children}
+    </WideNavigationRailItemNativeView>
+  );
+}
+
+/**
+ * Material 3 Expressive wide navigation rail for tablets, foldables and
+ * desktop-class Android windows.
+ */
+export const WideNavigationRail = Object.assign(WideNavigationRailComponent, {
+  Header: WideNavigationRailHeader,
+});
+
+/**
+ * A destination inside WideNavigationRail.
+ */
+export const WideNavigationRailItem = Object.assign(WideNavigationRailItemComponent, {
+  Icon: WideNavigationRailItemIcon,
+  Label: WideNavigationRailItemLabel,
+});
