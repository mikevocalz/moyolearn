diff --git a/Package.swift b/Package.swift
new file mode 100644
index 0000000000000000000000000000000000000000..f52ec804fe191d4e7597fd06c374a929a465ec5c
--- /dev/null
+++ b/Package.swift
@@ -0,0 +1,50 @@
+// swift-tools-version: 6.0
+// SwiftPM manifest for @react-native-masked-view/masked-view 0.3.2, for React
+// Native's SwiftPM autolinking. The package ships only RNCMaskedView.podspec.
+//
+// It compiles what the podspec compiles: source_files "ios/**/*.{h,m}", which is
+// two Objective-C files (a paper view manager and its RCTView subclass). The pod
+// declares no frameworks, defines or flags of its own; install_modules_dependencies
+// adds only the React dependencies and RCT_NEW_ARCH_ENABLED for C++, and this
+// package has no C++.
+//
+// The package, product and target are named RNCMaskedView (package.json
+// swiftpmConfig), the podspec's name. Package references are relative to the
+// autolinking symlink at ios/build/generated/autolinking/libs/RNCMaskedView.
+
+import PackageDescription
+
+let package = Package(
+    name: "RNCMaskedView",
+    platforms: [.iOS("17.0")],
+    products: [
+        .library(name: "RNCMaskedView", targets: ["RNCMaskedView"]),
+    ],
+    dependencies: [
+        .package(name: "ReactNative", path: "../../../../xcframeworks"),
+        .package(name: "React-GeneratedCode", path: "../../../ios"),
+    ],
+    targets: [
+        .target(
+            name: "RNCMaskedView",
+            dependencies: [
+                .product(name: "ReactHeaders", package: "ReactNative"),
+                .product(name: "ReactNativeHeaders", package: "ReactNative"),
+                .product(name: "ReactNativeDependenciesHeaders", package: "ReactNative"),
+                .product(name: "ReactAppHeaders", package: "React-GeneratedCode"),
+            ],
+            path: ".",
+            sources: [
+                "ios/RNCMaskedView.m",
+                "ios/RNCMaskedViewManager.m",
+            ],
+            publicHeadersPath: "ios",
+            cSettings: [
+                .headerSearchPath("ios"),
+                .headerSearchPath("."),
+                .unsafeFlags(["-include", "react-native-spm-prefix.h"]),
+            ],
+            linkerSettings: [.linkedFramework("UIKit"), .linkedFramework("Foundation")]
+        ),
+    ]
+)
