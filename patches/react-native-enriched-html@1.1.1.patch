+// swift-tools-version: 6.0
+// SwiftPM manifest for react-native-enriched-html 1.1.1, for React Native's
+// SwiftPM autolinking. The package ships only ReactNativeEnrichedHtml.podspec.
+//
+// Sources are the podspec's: "ios/**/*.{h,m,mm,cpp}" and "cpp/**/*.{h,hpp,c,cpp}"
+// minus "cpp/tests/**". That includes ios/generated, the Fabric codegen output the
+// package ships (codegenConfig.includesGeneratedCode), so the app's codegen skips
+// this library and these files are the only copy of its component descriptors.
+//
+// CocoaPods built with a header map and published every header under
+// Headers/Private/ReactNativeEnrichedHtml, so the sources reach each other two
+// ways that SwiftPM has no equivalent for:
+//   - quoted includes of a header in another directory ("StyleHeaders.h" from
+//     ios/utils): every source directory is a header search path below;
+//   - <ReactNativeEnrichedHtml/Props.h> and similar: spm/headers holds one
+//     forwarding header per name the sources use.
+// spm/headers also forwards the two React headers the sources include with
+// quotes ("RCTFabricComponentsPlugins.h", "UIView+React.h").
+//
+// The pod sets HEADER_SEARCH_PATHS to cpp/parser and cpp/GumboParser and gets
+// RCT_NEW_ARCH_ENABLED=1 and C++20 from install_modules_dependencies. The folly
+// defines match the other hand-written manifests here: FOLLY_NO_CONFIG skips
+// folly-config.h, so the values it would set are given directly.
+//
+// The package, product and target are named ReactNativeEnrichedHtml (package.json
+// swiftpmConfig), the podspec's name. Package references are relative to the
+// autolinking symlink at ios/build/generated/autolinking/libs/ReactNativeEnrichedHtml.
+
+import PackageDescription
+
+let headerPaths: [String] = [
+    ".",
+    "spm/headers",
+    "cpp/parser",
+    "cpp/GumboParser",
+    "ios",
+    "ios/config",
+    "ios/enrichedInputTextView",
+    "ios/enrichedTextTextView",
+    "ios/extensions",
+    "ios/generated/ReactCodegen/ReactNativeEnrichedSpec",
+    "ios/htmlParser",
+    "ios/inputAttributesManager",
+    "ios/inputHtmlParser",
+    "ios/interfaces",
+    "ios/internals",
+    "ios/styles",
+    "ios/textHtmlParser",
+    "ios/utils",
+]
+
+let prefixHeader = ["-include", "react-native-spm-prefix.h"]
+
+let package = Package(
+    name: "ReactNativeEnrichedHtml",
+    platforms: [.iOS("17.0")],
+    products: [
+        .library(name: "ReactNativeEnrichedHtml", targets: ["ReactNativeEnrichedHtml"]),
+    ],
+    dependencies: [
+        .package(name: "ReactNative", path: "../../../../xcframeworks"),
+        .package(name: "React-GeneratedCode", path: "../../../ios"),
+    ],
+    targets: [
+        .target(
+            name: "ReactNativeEnrichedHtml",
+            dependencies: [
+                .product(name: "ReactHeaders", package: "ReactNative"),
+                .product(name: "ReactNativeHeaders", package: "ReactNative"),
+                .product(name: "ReactNativeDependenciesHeaders", package: "ReactNative"),
+                .product(name: "ReactAppHeaders", package: "React-GeneratedCode"),
+            ],
+            path: ".",
+            sources: [
+                "cpp/parser/GumboNormalizer.c",
+                "cpp/parser/GumboParser.cpp",
+                "ios/config/EnrichedConfig.mm",
+                "ios/enrichedInputTextView/EnrichedInputTextView.mm",
+                "ios/EnrichedTextInputView.mm",
+                "ios/EnrichedTextInputViewManager.mm",
+                "ios/enrichedTextTextView/EnrichedTextTextView.mm",
+                "ios/EnrichedTextView.mm",
+                "ios/EnrichedTextViewManager.mm",
+                "ios/extensions/ColorExtension.mm",
+                "ios/extensions/FontExtension.mm",
+                "ios/extensions/ImageExtension.mm",
+                "ios/extensions/LayoutManagerExtension.mm",
+                "ios/extensions/StringExtension.mm",
+                "ios/generated/ReactCodegen/ReactNativeEnrichedSpec/ComponentDescriptors.cpp",
+                "ios/generated/ReactCodegen/ReactNativeEnrichedSpec/EventEmitters.cpp",
+                "ios/generated/ReactCodegen/ReactNativeEnrichedSpec/Props.cpp",
+                "ios/generated/ReactCodegen/ReactNativeEnrichedSpec/ShadowNodes.cpp",
+                "ios/generated/ReactCodegen/ReactNativeEnrichedSpec/States.cpp",
+                "ios/htmlParser/HtmlParser.mm",
+                "ios/inputAttributesManager/InputAttributesManager.mm",
+                "ios/inputHtmlParser/InputHtmlParser.mm",
+                "ios/interfaces/AlignmentEntry.mm",
+                "ios/interfaces/AttributeEntry.mm",
+                "ios/interfaces/ImageAttachment.mm",
+                "ios/interfaces/ImageData.mm",
+                "ios/interfaces/LinkData.mm",
+                "ios/interfaces/LinkRegexConfig.mm",
+                "ios/interfaces/MediaAttachment.mm",
+                "ios/interfaces/MentionParams.mm",
+                "ios/interfaces/MentionStyleProps.mm",
+                "ios/interfaces/StyleBase.mm",
+                "ios/interfaces/StylePair.mm",
+                "ios/interfaces/TextDecorationLineEnum.mm",
+                "ios/internals/EnrichedTextInputViewShadowNode.mm",
+                "ios/internals/EnrichedTextInputViewState.cpp",
+                "ios/internals/EnrichedTextViewShadowNode.mm",
+                "ios/internals/EnrichedTextViewState.cpp",
+                "ios/styles/AlignmentStyle.mm",
+                "ios/styles/BlockQuoteStyle.mm",
+                "ios/styles/BoldStyle.mm",
+                "ios/styles/CheckboxListStyle.mm",
+                "ios/styles/CodeBlockStyle.mm",
+                "ios/styles/EnrichedTextStyles.mm",
+                "ios/styles/H1Style.mm",
+                "ios/styles/H2Style.mm",
+                "ios/styles/H3Style.mm",
+                "ios/styles/H4Style.mm",
+                "ios/styles/H5Style.mm",
+                "ios/styles/H6Style.mm",
+                "ios/styles/HeadingStyleBase.mm",
+                "ios/styles/ImageStyle.mm",
+                "ios/styles/InlineCodeStyle.mm",
+                "ios/styles/ItalicStyle.mm",
+                "ios/styles/LinkStyle.mm",
+                "ios/styles/MentionStyle.mm",
+                "ios/styles/OrderedListStyle.mm",
+                "ios/styles/StrikethroughStyle.mm",
+                "ios/styles/UnderlineStyle.mm",
+                "ios/styles/UnorderedListStyle.mm",
+                "ios/textHtmlParser/TextHtmlParser.mm",
+                "ios/utils/AlignmentUtils.mm",
+                "ios/utils/AttachmentLayoutUtils.mm",
+                "ios/utils/CheckboxHitTestUtils.mm",
+                "ios/utils/DotReplacementUtils.mm",
+                "ios/utils/EnrichedTextTouchHandler.mm",
+                "ios/utils/KeyboardUtils.mm",
+                "ios/utils/OccurenceUtils.mm",
+                "ios/utils/ParagraphAttributesUtils.mm",
+                "ios/utils/RangeUtils.mm",
+                "ios/utils/ShortcutsUtils.mm",
+                "ios/utils/StyleUtils.mm",
+                "ios/utils/TextBlockTapGestureRecognizer.mm",
+                "ios/utils/TextInsertionUtils.mm",
+                "ios/utils/TextListsUtils.mm",
+                "ios/utils/WeakBox.m",
+                "ios/utils/WordsUtils.mm",
+                "ios/utils/ZeroWidthSpaceUtils.mm",
+            ],
+            publicHeadersPath: "spm/public",
+            cSettings: headerPaths.map { .headerSearchPath($0) } + [.unsafeFlags(prefixHeader)],
+            cxxSettings: headerPaths.map { .headerSearchPath($0) } + [
+                .define("RCT_NEW_ARCH_ENABLED", to: "1"),
+                .define("FOLLY_NO_CONFIG"),
+                .define("FOLLY_CFG_NO_COROUTINES", to: "1"),
+                .define("FOLLY_MOBILE", to: "1"),
+                .define("FOLLY_USE_LIBCPP", to: "1"),
+                .define("DEBUG", .when(configuration: .debug)),
+                .define("NDEBUG", .when(configuration: .release)),
+                .unsafeFlags(prefixHeader + ["-Wno-comma", "-Wno-shorten-64-to-32"]),
+            ],
+            linkerSettings: [
+                .linkedFramework("UIKit"),
+                .linkedFramework("Foundation"),
+                .linkedFramework("CoreGraphics"),
+                // Imported by the sources and auto-linked through clang modules
+                // under CocoaPods; named here so the link does not depend on that.
+                .linkedFramework("CoreText"),
+                .linkedFramework("UniformTypeIdentifiers"),
+            ]
+        ),
+    ],
+    cxxLanguageStandard: .cxx20
+)
