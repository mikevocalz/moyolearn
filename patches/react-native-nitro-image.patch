diff --git a/android/build.gradle b/android/build.gradle
index 8f83cbe363689159484e2a4659e873e7d2057852..0b0fd937a4bd6172c1fb599c22b6f05be8177768 100644
--- a/android/build.gradle
+++ b/android/build.gradle
@@ -38,6 +38,24 @@ def getExtOrIntegerDefault(name) {
 android {
   namespace "com.margelo.nitro.image"
 
+  /*
+    Same exclusion as the vision-camera patch, and for the same reason: with no
+    `codegenConfig` in package.json, React Native's gradle plugin generates
+    React's own core view-manager delegates and module specs into this module.
+    This library is Nitro-based and imports none of them, but two libraries
+    each compiling a copy makes the app's dex merge fail with
+    "Type ... is defined multiple times". react-android provides them at
+    runtime; a library must not ship them.
+  */
+  sourceSets {
+    main {
+      java {
+        exclude 'com/facebook/react/viewmanagers/**'
+        exclude 'com/facebook/fbreact/specs/**'
+      }
+    }
+  }
+
   ndkVersion getExtOrDefault("ndkVersion")
   compileSdkVersion getExtOrIntegerDefault("compileSdkVersion")
 
@@ -140,7 +158,7 @@ dependencies {
   // For < 0.71, this will be from the local maven repo
   // For > 0.71, this will be replaced by `com.facebook.react:react-android:$version` by react gradle plugin
   //noinspection GradleDynamicVersion
-  implementation "com.facebook.react:react-native:+"
+  compileOnly "com.facebook.react:react-native:+"
 
   // Add a dependency on NitroModules
   implementation project(":react-native-nitro-modules")
