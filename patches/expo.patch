+/**
+ * The podspec dependencies React Native autolinked as SwiftPM packages, by the
+ * libs/<name> alias it writes for each (react-native/scripts/spm/
+ * generate-spm-autolinking.js). CocoaPods links such a dependency for the module
+ * (expo-router's `add_dependency(s, "RNScreens")`); without it a pure-Swift module
+ * that imports the library fails with "Unable to resolve module dependency".
+ * Only aliases whose manifest exports a library of the same name are used.
+ */
+function autolinkedLibDependencies(podDependencies, libsDir) {
+  if (libsDir == null) return [];
+  const names = new Set((podDependencies ?? []).map((dep) => dep.split('/')[0]));
+  return [...names].filter((name) => {
+    const manifest = path.join(libsDir, name, 'Package.swift');
+    if (!fs.existsSync(manifest)) return false;
+    return fs.readFileSync(manifest, 'utf8').includes(`.library(name: "${name}"`);
+  }).map((name) => {
+    // The dependent package cannot sit below the library's iOS floor.
+    const text = fs.readFileSync(path.join(libsDir, name, 'Package.swift'), 'utf8');
+    const iosFloor = text.match(/\.iOS\("([0-9.]+)"\)/)?.[1] ?? null;
+    return { name, path: path.join(libsDir, name), iosFloor };
+  });
+}
