+++ b/spm/base/module.modulemap
@@ -0,0 +1,13 @@
+// The Objective-C pieces the Swift sources call into. Listed one by one so the
+// Fabric views under ios/views (C++ headers) stay out of the Swift-facing module.
+module KeyboardControllerBase {
+  header "../../ios/KeyboardControllerModule-Header.h"
+  header "../../ios/events/KeyboardMoveEvent.h"
+  header "../../ios/events/FocusedInputLayoutChangedEvent.h"
+  header "../../ios/events/FocusedInputSelectionChangedEvent.h"
+  header "../../ios/events/FocusedInputTextChangedEvent.h"
+  header "../../ios/objc/NSObject+SafeKVC.h"
+  header "../../ios/objc/RCTUIManager+LayoutAnimationManager.h"
+  header "../../ios/objc/TextInput+DelegateManager.h"
+  export *
+}
