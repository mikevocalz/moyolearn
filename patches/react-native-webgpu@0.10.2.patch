diff --git a/apple/ApplePlatformContext.mm b/apple/ApplePlatformContext.mm
index 6f953bbfc185db738ec9272f93d5269058100559..8c55484bf804962468fdcfa898e642060b3e86c7 100644
--- a/apple/ApplePlatformContext.mm
+++ b/apple/ApplePlatformContext.mm
@@ -165,8 +165,26 @@ ApplePlatformContext::loadVideoFrame(const std::string &path) {
                    : [NSURL fileURLWithPath:nsPath];
   AVURLAsset *asset = [AVURLAsset assetWithURL:url];
 
+#if TARGET_OS_VISION
+  __block NSArray<AVAssetTrack *> *videoTracks = nil;
+  __block NSError *trackError = nil;
+  dispatch_semaphore_t tracksLoaded = dispatch_semaphore_create(0);
+  [asset loadTracksWithMediaType:AVMediaTypeVideo
+              completionHandler:^(NSArray<AVAssetTrack *> *tracks, NSError *error) {
+                videoTracks = tracks;
+                trackError = error;
+                dispatch_semaphore_signal(tracksLoaded);
+              }];
+  dispatch_semaphore_wait(tracksLoaded, DISPATCH_TIME_FOREVER);
+  if (trackError) {
+    throw std::runtime_error(
+        std::string("loadVideoFrame: track loading failed: ") +
+        [[trackError localizedDescription] UTF8String]);
+  }
+#else
   NSArray<AVAssetTrack *> *videoTracks =
       [asset tracksWithMediaType:AVMediaTypeVideo];
+#endif
   if (videoTracks.count == 0) {
     throw std::runtime_error("loadVideoFrame: no video track in file");
   }
