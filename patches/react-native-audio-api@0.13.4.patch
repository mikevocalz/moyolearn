+// swift-tools-version: 6.0
+// SwiftPM manifest for react-native-audio-api 0.13.4, for React Native's SwiftPM
+// autolinking. The package ships only RNAudioAPI.podspec. This file reproduces
+// what that podspec builds with its defaults (FFmpeg on, static external libs
+// on, worklets on because react-native-worklets 0.13.1 passes its >= 0.7.0
+// check):
+//
+//   Sources      common/cpp/audioapi/**/*.{cpp,c} and ios/audioapi/**/*.{m,mm}.
+//                Two podspec subspecs set per-file flags, which SwiftPM cannot,
+//                so each becomes something SwiftPM can express:
+//                  - audioapi_dsp compiles dsp/**/*.cpp with -O3: the
+//                    RNAudioAPIDSP target, with the same defines, header paths
+//                    and dependencies as RNAudioAPI so the shared headers see
+//                    the same configuration;
+//                  - miniaudio_impl compiles utils/MiniaudioImplementation.cpp
+//                    with "-x objective-c++": spm/MiniaudioImplementation.mm
+//                    includes that file, so it compiles as Objective-C++.
+//   Defines      RCT_NEW_ARCH_ENABLED, AUDIOAPI_VERSION, HAVE_ACCELERATE and
+//                RN_AUDIO_API_ENABLE_WORKLETS, from OTHER_CFLAGS and
+//                GCC_PREPROCESSOR_DEFINITIONS, so C, Objective-C and C++ all get
+//                them. The folly defines match the other hand-written manifests.
+//   Headers      The pod's header_dir mappings put common/cpp/audioapi and
+//                ios/audioapi under <audioapi/...>; here that is common/cpp and
+//                ios on the search path. external/include (plus its opus and
+//                vorbis folders) and external/include_ffmpeg are the pod's
+//                HEADER_SEARCH_PATHS.
+//   Worklets     s.dependency 'RNWorklets' becomes the RNWorklets package, at
+//                the sibling autolinking symlink as in react-native-reanimated's
+//                manifest. package.json swiftpmConfig.dependencies names it too.
+//   Binaries     prepare_command downloads release v3.1.0 of
+//                software-mansion-labs/rn-audio-libs. Nothing runs it under
+//                SwiftPM, so tooling/ios-spm.mjs runs
+//                scripts/download-prebuilt-binaries.sh before `react-native spm`
+//                resolves packages. It fills common/cpp/audioapi/external/ with
+//                  - ffmpeg_ios/lib{avcodec,avformat,avutil,swresample}.xcframework,
+//                    dynamic frameworks (s.ios.vendored_frameworks), linked here
+//                    as binary targets, which also embeds them in the app;
+//                  - <PLATFORM_NAME>/lib{opusfile,opus,ogg,vorbis,vorbisenc,
+//                    vorbisfile}.a, which the pod force-loads through
+//                    OTHER_LDFLAGS. Same flags here.
+//   Frameworks   Accelerate, AVFoundation and MediaPlayer (s.ios.frameworks).
+//
+// The package and product are named RNAudioAPI (package.json swiftpmConfig), the
+// podspec's name. Package references are relative to the autolinking symlink at
+// ios/build/generated/autolinking/libs/RNAudioAPI.
+
+import Foundation
+import PackageDescription
+
+// Absolute, because linker flags are not resolved against the package directory.
+let packageDir = URL(fileURLWithPath: #filePath).deletingLastPathComponent().path
+let externalDir = "\(packageDir)/common/cpp/audioapi/external"
+
+let staticExternalLibs = ["libopusfile", "libopus", "libogg", "libvorbis", "libvorbisenc", "libvorbisfile"]
+let ffmpegFrameworks = ["libavcodec", "libavformat", "libavutil", "libswresample"]
+
+let dependencies: [Target.Dependency] = [
+    .product(name: "ReactHeaders", package: "ReactNative"),
+    .product(name: "ReactNativeHeaders", package: "ReactNative"),
+    .product(name: "ReactNativeDependenciesHeaders", package: "ReactNative"),
+    .product(name: "ReactAppHeaders", package: "React-GeneratedCode"),
+    .product(name: "RNWorklets", package: "RNWorklets"),
+]
+
+let headerPaths: [String] = [
+    ".",
+    "common/cpp",
+    "ios",
+    // The iOS sources include their siblings by bare name (<AudioEngine.h>,
+    // <NativeAudioPlayer.h>), which CocoaPods resolved through its header map.
+    "ios/audioapi/ios/core",
+    "ios/audioapi/ios/system",
+    "common/cpp/audioapi/external/include",
+    "common/cpp/audioapi/external/include/opus",
+    "common/cpp/audioapi/external/include/vorbis",
+    "common/cpp/audioapi/external/include_ffmpeg",
+]
+
+let ffmpegTargets: [Target] = ffmpegFrameworks.map {
+    .binaryTarget(name: $0, path: "common/cpp/audioapi/external/ffmpeg_ios/\($0).xcframework")
+}
+let ffmpegDependencies: [Target.Dependency] = ffmpegFrameworks.map { .target(name: $0) }
+
+let defines: [(String, String)] = [
+    ("RCT_NEW_ARCH_ENABLED", "1"),
+    ("AUDIOAPI_VERSION", "0.13.4"),
+    ("HAVE_ACCELERATE", "1"),
+    ("RN_AUDIO_API_ENABLE_WORKLETS", "1"),
+]
+
+let prefixHeader = ["-include", "react-native-spm-prefix.h"]
+
+let cSettings: [CSetting] =
+    headerPaths.map { .headerSearchPath($0) }
+    + defines.map { .define($0.0, to: $0.1) }
+    + [.unsafeFlags(prefixHeader)]
+
+let cxxSettings: [CXXSetting] =
+    headerPaths.map { .headerSearchPath($0) }
+    + defines.map { .define($0.0, to: $0.1) }
+    + [
+        .define("FOLLY_NO_CONFIG"),
+        // FOLLY_NO_CONFIG skips folly-config.h, which is where React Native turns coroutines off.
+        .define("FOLLY_CFG_NO_COROUTINES", to: "1"),
+        .define("FOLLY_MOBILE", to: "1"),
+        .define("FOLLY_USE_LIBCPP", to: "1"),
+        .define("DEBUG", .when(configuration: .debug)),
+        .define("NDEBUG", .when(configuration: .release)),
+        .unsafeFlags(prefixHeader + ["-Wno-comma", "-Wno-shorten-64-to-32"]),
+    ]
+
+let package = Package(
+    name: "RNAudioAPI",
+    platforms: [.iOS("17.0")],
+    products: [
+        .library(name: "RNAudioAPI", targets: ["RNAudioAPI"]),
+    ],
+    dependencies: [
+        .package(name: "ReactNative", path: "../../../../xcframeworks"),
+        .package(name: "React-GeneratedCode", path: "../../../ios"),
+        .package(name: "RNWorklets", path: "../RNWorklets"),
+    ],
+    targets: ffmpegTargets + [
+        .target(
+            name: "RNAudioAPIDSP",
+            dependencies: dependencies,
+            path: ".",
+            sources: [
+                "common/cpp/audioapi/dsp/Convolver.cpp",
+                "common/cpp/audioapi/dsp/FFT.cpp",
+                "common/cpp/audioapi/dsp/VectorMath.cpp",
+                "common/cpp/audioapi/dsp/WaveShaper.cpp",
+                "common/cpp/audioapi/dsp/WsolaTimeStretcher.cpp",
+            ],
+            publicHeadersPath: "spm/dsp",
+            cxxSettings: cxxSettings + [.unsafeFlags(["-O3"])],
+            linkerSettings: [.linkedFramework("Accelerate")]
+        ),
+        .target(
+            name: "RNAudioAPI",
+            dependencies: dependencies + ["RNAudioAPIDSP"] + ffmpegDependencies,
+            path: ".",
+            sources: [
+                "common/cpp/audioapi/core/analysis/AnalyserNode.cpp",
+                "common/cpp/audioapi/core/AudioContext.cpp",
+                "common/cpp/audioapi/core/AudioNode.cpp",
+                "common/cpp/audioapi/core/AudioParam.cpp",
