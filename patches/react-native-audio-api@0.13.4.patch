@@ -0,0 +1,4 @@
+// Compiles miniaudio's implementation as Objective-C++. The podspec does this with
+// a per-file "-x objective-c++" on the .cpp (its miniaudio_impl subspec); SwiftPM
+// has no per-file flags, and a .mm file gets the same language mode.
+#include "../common/cpp/audioapi/utils/MiniaudioImplementation.cpp"
