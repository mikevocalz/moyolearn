+                "common/cpp/audioapi/core/destinations/AudioDestinationNode.cpp",
+                "common/cpp/audioapi/core/effects/BiquadFilterNode.cpp",
+                "common/cpp/audioapi/core/effects/ConvolverNode.cpp",
+                "common/cpp/audioapi/core/effects/DelayNode.cpp",
+                "common/cpp/audioapi/core/effects/GainNode.cpp",
+                "common/cpp/audioapi/core/effects/IIRFilterNode.cpp",
+                "common/cpp/audioapi/core/effects/PeriodicWave.cpp",
+                "common/cpp/audioapi/core/effects/StereoPannerNode.cpp",
+                "common/cpp/audioapi/core/effects/WaveShaperNode.cpp",
+                "common/cpp/audioapi/core/effects/WorkletNode.cpp",
+                "common/cpp/audioapi/core/effects/WorkletProcessingNode.cpp",
+                "common/cpp/audioapi/core/inputs/AudioRecorder.cpp",
+                "common/cpp/audioapi/core/OfflineAudioContext.cpp",
+                "common/cpp/audioapi/core/sources/AudioBufferBaseSourceNode.cpp",
