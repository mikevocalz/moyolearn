{
  "name": "moyo",
  "version": "0.1.0",
  "private": true,
  "description": "Moyo \u2014 AI tutoring that helps children learn it by heart. Universal Expo + Next.js (Payload) monorepo.",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.15.0 <26"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "node tooling/check-no-flatlist.mjs && node tooling/check-barrels.mjs && node tooling/check-contrast.mjs && node tooling/check-targets.mjs && node tooling/check-utilities.mjs && node tooling/check-controls.mjs && node tooling/check-references.mjs && node tooling/check-runtime-classes.mjs && node tooling/check-no-training-path.mjs && node tooling/check-voice-egress.mjs && node tooling/check-store-separation.mjs && node tooling/check-crm-wall.mjs && node tooling/check-fail-closed.mjs && node tooling/check-versions-off.mjs && node tooling/check-sentry-invariants.mjs && node tooling/check-role-accent.mjs && node tooling/check-copy-law.mjs && turbo lint",
    "check:barrels": "node tooling/check-barrels.mjs",
    "check:contrast": "node tooling/check-contrast.mjs",
    "check:copylaw": "node tooling/check-copy-law.mjs",
    "check:targets": "node tooling/check-targets.mjs",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "gen": "node tooling/generators/gen.mjs",
    "check:utilities": "node tooling/check-utilities.mjs",
    "check:references": "node tooling/check-references.mjs",
    "check:training": "node tooling/check-no-training-path.mjs",
    "check:separation": "node tooling/check-store-separation.mjs",
    "check:crmwall": "node tooling/check-crm-wall.mjs",
    "check:failclosed": "node tooling/check-fail-closed.mjs",
    "check:runtime": "node tooling/check-runtime-classes.mjs",
    "jobs:install": "pg-boss create --schema jobs --connection-string \"$DATABASE_URL\"",
    "jobs:migrate": "pg-boss migrate --schema jobs --connection-string \"$DATABASE_URL\"",
    "jobs:doctor": "pg-boss doctor --schema jobs --connection-string \"$DATABASE_URL\"",
    "ui:sweep": "node tooling/ui-sweep.mjs",
    "check:voice": "node tooling/check-voice-egress.mjs",
    "check:sentry": "node tooling/check-sentry-invariants.mjs",
    "check:roleaccent": "node tooling/check-role-accent.mjs"
  },
  "devDependencies": {
    "pg-boss": "catalog:",
    "turbo": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@payloadcms/plugin-cloud-storage": "4.0.0-canary.29",
      "@payloadcms/translations": "4.0.0-canary.29"
    },
    "patchedDependencies": {
      "@seshuk/payload-storage-bunny@3.0.0": "patches/@seshuk__payload-storage-bunny@3.0.0.patch"
    }
  }
}
